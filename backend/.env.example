# Copy this file to .env and fill in your real values.
# .env is ignored by git, so these never get uploaded.

# ---- Nokia Network as Code ----
NOKIA_NAC_API_KEY=
WEBHOOK_BASE_URL=http://localhost:8000
WEBHOOK_AUTH_TOKEN=change-me
REDIS_URL=redis://localhost:6379/0

# ---- User database (used by app/usersDB/db.py) ----
# WARNING: the variable is literally called USERNAME. On Linux and macOS the
# operating system already sets USERNAME or USER, so this can silently pick up
# your computer login instead of your database user. Renaming it to DB_USERNAME
# would be safer.
DRIVERNAME=postgresql+psycopg2
USERNAME=crovia
PASSWORD=
HOST=localhost
PORT=5432
DATABASE=crovia
