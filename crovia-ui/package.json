{
  "name": "crovia-ui",
  "version": "0.1.0",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "npm run sync:maplibre && expo start --web",
    "typecheck": "tsc --noEmit",
    "sync:maplibre": "node scripts/sync-maplibre-worker.mjs",
    "postinstall": "node scripts/sync-maplibre-worker.mjs",
    "build:web": "npm run sync:maplibre && expo export --platform web"
  },
  "dependencies": {
    "@expo-google-fonts/manrope": "^0.4.2",
    "@expo/metro-runtime": "~57.0.15",
    "@gluestack-style/react": "^1.0.57",
    "@gluestack-ui/config": "^1.1.20",
    "@gluestack-ui/themed": "^1.1.73",
    "@turf/circle": "^7.4.0",
    "@turf/helpers": "^7.4.0",
    "expo": "~57.0.21",
    "expo-font": "^57.0.3",
    "expo-status-bar": "~57.0.1",
    "maplibre-gl": "^6.7.0",
    "pmtiles": "^4.5.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "puppeteer-core": "^24.43.1",
    "typescript": "~6.0.3"
  }
}
