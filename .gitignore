# ---------------------------------------------------------------------------
# Secrets — never commit these.
# A .env file normally holds API keys. Anything committed here stays in the
# git history forever, even after the file is deleted later.
# ---------------------------------------------------------------------------
.env
*.env
!*.env.example

# ---------------------------------------------------------------------------
# Project
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Virtualenv
# https://realpython.com/python-virtual-environments-a-primer/#the-virtualenv-project
# ---------------------------------------------------------------------------
.venv/
venv/
.python-version

# pyenv: Simple Python Version Management
pyvenv.cfg

# pip: package installer for Python
pip-selfcheck.json

# Custom python interpreter
.Python

# ---------------------------------------------------------------------------
# Python build artefacts
# ---------------------------------------------------------------------------
__pycache__/
*.pyc

# ---------------------------------------------------------------------------
# Notebooks
# ---------------------------------------------------------------------------
.ipynb_checkpoints/

# Runtime database. Regenerated on start; must not be committed.
backend/crovia.db
*.db

# Python virtualenv folders, named precisely.
#
# This used to read [Bb]in, [Ll]ib, [Ss]cripts and so on, copied from a
# template for another language. Those match a folder of that name ANYWHERE in
# the repository, so crovia-ui/scripts/ was one command away from vanishing and
# any future backend/lib/ would have disappeared without a word.
backend/venv/
backend/.venv/

# ---------------------------------------------------------------------------
# Simulation output
# Rewritten by sim/run.py and sim/sweep.py on every run, so committing them
# only stores a new 255 KB copy of a file the code regenerates anyway.
# ---------------------------------------------------------------------------
backend/sim/out_*.json

# ---------------------------------------------------------------------------
# Kept on disk, out of the repository
#
# Langgraph_structure/ holds the first draft of the agent as notebooks. The
# finished agent is backend/app/ai/graph.py, so the notebooks are working
# history rather than part of the product.
#
# Docs/ holds personal study notes on the Nokia APIs, partly written in
# Arabic. They were written to learn from, not to be read by a visitor.
#
# Both are still in the git history if they are ever needed again.
# ---------------------------------------------------------------------------
Langgraph_structure/
Docs/
