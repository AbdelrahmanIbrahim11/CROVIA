# Copy to .env and fill in. .env is ignored by git, so your keys stay local.
#
# Nothing here is required to run locally. With an empty file the backend
# starts on SQLite, uses the simulated city instead of Nokia, and uses
# deterministic rules instead of the model.

# --- required in a deployment, ignored locally -----------------------------
# Set this to anything other than "local" and the service refuses to start
# without the two settings below, rather than running on unsafe defaults.
CROVIA_ENV=local

# Signs the login tokens. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# Which addresses may call this API from a browser. Never "*" in a deployment.
CORS_ORIGINS=*

# --- database --------------------------------------------------------------
# One line is enough; this is what Render, Railway and Fly hand you.
# Leave it empty to use a local SQLite file.
DATABASE_URL=

# --- Nokia Network as Code -------------------------------------------------
# Without a key the backend uses Nokia's published test numbers, or the twin.
NOKIA_NAC_API_KEY=
# This service's own public address. Nokia sends notifications here, so it
# must be reachable from the internet - a laptop address will never receive.
WEBHOOK_BASE_URL=http://localhost:8000
WEBHOOK_AUTH_TOKEN=change-me

# --- the agent -------------------------------------------------------------
# Without a key the deterministic rules run instead. Detection is unaffected.
GROQ_API_KEY=
CROVIA_MODEL=openai/gpt-oss-120b

# --- the simulated city, for demos ----------------------------------------
CROVIA_TWIN=
CROVIA_TWIN_SPEED=12
NOKIA_NAC_HOST=network-as-code.nokia.rapidapi.com
