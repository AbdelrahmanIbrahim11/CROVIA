# Copy to .env and fill in. .env is ignored by git, so your keys stay local.
#
# Nothing here is required to run locally. With an empty file the backend
# starts on SQLite, uses the simulated city instead of Nokia, and uses
# deterministic rules instead of the model.

# --- required in a deployment, ignored locally -----------------------------
# Set this to anything other than "local" and the service refuses to start
# without the two settings below, rather than running on unsafe defaults.
CROVIA_ENV=local

# Signs the login tokens. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# Which addresses may call this API from a browser. Never "*" in a deployment.
CORS_ORIGINS=*

# --- database --------------------------------------------------------------
# One line is enough; this is what Render, Railway and Fly hand you.
# Leave it empty to use a local SQLite file.
DATABASE_URL=

# --- Nokia Network as Code -------------------------------------------------
# Without a key the backend uses Nokia's published test numbers, or the twin.
NOKIA_NAC_API_KEY=
# This service's own public address. Nokia sends notifications here, so it
# must be reachable from the internet - a laptop address will never receive.
WEBHOOK_BASE_URL=http://localhost:8000
WEBHOOK_AUTH_TOKEN=change-me

# --- the agent -------------------------------------------------------------
# Without a key the deterministic rules run instead. Detection is unaffected.
GROQ_API_KEY=
CROVIA_MODEL=openai/gpt-oss-120b

# --- the simulated city, for demos ----------------------------------------
CROVIA_TWIN=
CROVIA_TWIN_SPEED=12
NOKIA_NAC_HOST=network-as-code.nokia.rapidapi.com

# Needed to create an operator or authority account. Leave it empty and those
# accounts cannot be created at all - a citizen sign-up is still open, which is
# the point of the product. Without this, anyone who found the address could ask
# for an admin account and be given one.
STAFF_INVITE_CODE=

# --- priority for responders during an incident (Quality on Demand) --------
# When an alarm fires, CROVIA asks the network to protect these phones'
# connection to the backend, and hands it back when the incident closes. The
# network is at its worst exactly when a crowd forms, which is when the people
# responding most need the app to answer.
#
# Leave either of the two empty and the feature stays off.
AUTHORITY_DEVICES=
# CROVIA's own public IP. QoD prioritises the path to ONE named server, so
# without this there is nothing to prioritise towards.
QOD_APP_SERVER_IP=
# QOS_E holds latency steady under congestion. The larger profiles chase
# throughput, which is not what a map and an acknowledge button need.
QOD_PROFILE=QOS_E
# Sessions are billed while they live. An hour is long enough for an incident
# and short enough that one forgotten by a crash expires on its own.
QOD_DURATION_SECONDS=3600
